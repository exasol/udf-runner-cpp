module(name = "udf_v2_simulators", version = "0.1.0")

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "flatbuffers", version = "25.2.10")
bazel_dep(name = "platforms", version = "1.0.0")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_archive(
    name = "simulator_json",
    urls = ["https://github.com/nlohmann/json/archive/refs/tags/v3.12.0.tar.gz"],
    sha256 = "4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187",
    strip_prefix = "json-3.12.0",
    build_file_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "nlohmann_json",
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
)
""",
)

new_local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)

new_local_repository(
    name = "simulator_v2_sources",
    path = "../../udf-runner-cpp/v2",
    build_file = "//:v2_sources.BUILD.bazel",
)
