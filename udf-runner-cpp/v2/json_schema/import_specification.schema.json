{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": ["is_subselect"],
  "properties": {
    "is_subselect": { "type": "boolean" },
    "connection_information": { "$ref": "connection_information.schema.json" },
    "connection_name": { "type": "string" },
    "subselect_column_specification": { "type": "array", "items": { "$ref": "#/definitions/column" } },
    "parameters": { "type": "array", "items": { "$ref": "#/definitions/key_value" } }
  },
  "definitions": {
    "column": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "type_name"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["DOUBLE PRECISION", "DECIMAL", "DATE", "TIMESTAMP", "TIMESTAMP WITH LOCAL TIME ZONE", "CHAR", "VARCHAR", "BOOLEAN", "HASHTYPE", "GEOMETRY", "INTERVAL YEAR TO MONTH", "INTERVAL DAY TO SECOND"] },
        "type_name": { "type": "string", "description": "The complete Exasol SQL type declaration, including parameters where applicable." },
        "size": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "scale": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "key_value": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "value"],
      "properties": { "key": { "type": "string" }, "value": { "type": "string" } }
    }
  }
}
